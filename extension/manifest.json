{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "short_name": "Mnemoloci",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*.ts.net/*"],
  "action": { "default_popup": "popup.html", "default_title": "__MSG_actionTitle__", "default_icon": "icon-128.png" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "128": "icon-128.png" }
}
